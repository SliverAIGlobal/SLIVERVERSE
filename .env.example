# Serenity AI Empathy Assistant - Environment Configuration Example
# Copy this file to .env or .env.local and populate your credentials

# HuggingFace API Key for Gemma 2B/9B and Mistral 7B inference
VITE_HF_API_KEY=your_huggingface_api_key_here

# Gumroad License Verification API Key (Optional for backend license checks)
VITE_GUMROAD_ACCESS_TOKEN=your_gumroad_access_token_here
